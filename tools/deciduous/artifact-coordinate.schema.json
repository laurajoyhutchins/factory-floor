{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-floor.invalid/schemas/artifact-coordinate-v1.json",
  "title": "Artifact Coordinate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_name",
    "version",
    "target_platform",
    "sha256",
    "source_provenance",
    "acquisition_method",
    "review_status",
    "storage_location",
    "verification_date"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "tool_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "target_platform": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "release_tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "release_tag": { "type": "string", "minLength": 1 }
      }
    },
    "acquisition_method": { "type": "string", "minLength": 1 },
    "review_status": { "enum": ["unreviewed", "reviewed", "rejected"] },
    "storage_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "path"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "verification_date": { "type": "string", "format": "date" }
  }
}
